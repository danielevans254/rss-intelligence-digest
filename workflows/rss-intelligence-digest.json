        0
      ],
      "notesInFlow": true,
      "notes": "Deduplicates, filters by time and keyword, strips HTML, bounds text, and caps output."
    },
    {
      "parameters": {
        "jsCode": "const d=$input.first().json; const lines=d.items.map((i,n)=>(n+1)+'. '+i.title+'\\n'+i.link); const text='RSS intelligence digest — '+d.item_count+' item(s)\\n\\n'+(lines.join('\\n\\n') || 'No matching items.'); return [{json:{...d,notification_text:text}}];"
      },
