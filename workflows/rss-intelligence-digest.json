      "id": "cf7d23e9-96a4-412e-80e3-0342714d24d7",
      "name": "Read RSS Feeds",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.2,
      "position": [
        300,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const select = function selectRssItems(items, options = {}) {\n  const rows = Array.isArray(items) ? items : [];\n  const maxItems = Math.max(1, Math.min(Number(options.max_items || 10), 50));\n  const keywords = (options.keywords || []).map((v) => String(v).trim().toLowerCase()).filter(Boolean);\n  const excluded = (options.exclude_keywords || []).map((v) => String(v).trim().toLowerCase()).filter(Boolean);\n  const now = new Date(options.now || Date.now());\n  const lookbackHours = Math.max(1, Math.min(Number(options.lookback_hours || 168), 24 * 90));\n  const cutoff = now.getTime() - (lookbackHours * 60 * 60 * 1000);\n  const seen = new Set();\n  const selected = [];\n\n  for (const item of rows) {\n    const title = String(item?.title || '').trim();\n    const link = String(item?.link || item?.url || '').trim();\n    const summary = String(item?.contentSnippet || item?.content || item?.description || '').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\n    const publishedAt = item?.isoDate || item?.pubDate || item?.published_at || item?.date || null;\n    const publishedTime = publishedAt ? new Date(publishedAt).getTime() : Number.NaN;\n    const haystack = `${title}\\n${summary}`.toLowerCase();\n    if (!title || !link) continue;\n    if (Number.isFinite(publishedTime) && publishedTime < cutoff) continue;\n    if (keywords.length && !keywords.some((keyword) => haystack.includes(keyword))) continue;\n    if (excluded.some((keyword) => haystack.includes(keyword))) continue;\n    const id = String(item?.guid || item?.id || link || title);\n    if (seen.has(id)) continue;\n    seen.add(id);\n    selected.push({\n      id,\n      title,\n      link,\n      summary: summary.slice(0, 1000),\n      source: String(item?.source || item?.feedTitle || item?.creator || 'RSS'),\n      published_at: publishedAt ? new Date(publishedAt).toISOString() : null,\n    });\n  }\n\n  return selected\n    .sort((a, b) => new Date(b.published_at || 0).getTime() - new Date(a.published_at || 0).getTime())\n    .slice(0, maxItems);\n};\nconst req = $('Normalize RSS Request').first().json;\nconst selected = select($input.all().map(i => i.json), req.filters);\nreturn [{json:{...req,items:selected,item_count:selected.length}}];"
      },
      "id": "378613e8-1fff-477b-a4bf-fa280e67a057",
      "name": "Select RSS Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
