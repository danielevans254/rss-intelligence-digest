    {
      "parameters": {
        "jsCode": "const raw=$json.body ?? $json;\nconst envFeeds=String($env.RSS_FEED_URLS || 'https://hnrss.org/frontpage').split(',').map(v=>v.trim()).filter(Boolean);\nconst feedUrls=Array.isArray(raw.feed_urls)?raw.feed_urls.map(String):envFeeds;\nif(!feedUrls.length) throw new Error('At least one feed URL is required');\nreturn [{json:{test_mode:raw.test_mode===true,run_id:String(raw.run_id || ('rss-'+Date.now())),feed_urls:feedUrls,filters:{keywords:Array.isArray(raw.filters?.keywords)?raw.filters.keywords:[],exclude_keywords:Array.isArray(raw.filters?.exclude_keywords)?raw.filters.exclude_keywords:[],max_items:Number(raw.filters?.max_items || 10),lookback_hours:Number(raw.filters?.lookback_hours || 168),now:raw.filters?.now || new Date().toISOString()},mock_items:Array.isArray(raw.mock_items)?raw.mock_items:[]}}];"
      },
